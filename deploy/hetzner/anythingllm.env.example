DOMAIN=lovora.example.com
ACME_EMAIL=ops@example.com

SERVER_PORT=3001
STORAGE_DIR="/app/server/storage"
JWT_SECRET=
SIG_KEY=
SIG_SALT=
# Set AUTH_TOKEN only when JWT_SECRET is also configured.
AUTH_TOKEN=
ANYTHINGLLM_API_KEY=

# Auth bootstrap expects Better Auth to be configured and a default workspace slug
# that matches the workspace created during boot/backfill.
DEFAULT_WORKSPACE_SLUG=workspace
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://lovora.example.com
BETTER_AUTH_API_KEY=
BETTER_AUTH_TRUSTED_ORIGINS=https://lovora.example.com

LLM_PROVIDER='xai'
XAI_LLM_API_KEY=
XAI_LLM_MODEL_PREF='grok-4.20-reasoning'

EMBEDDING_ENGINE='voyageai'
VOYAGEAI_API_KEY=
EMBEDDING_MODEL_PREF='voyage-law-2'

VECTOR_DB='lancedb'
WHISPER_PROVIDER='local'
TTS_PROVIDER='native'
DISABLE_TELEMETRY='true'

# Alpha free-tier gate for public rollout.
FREE_MESSAGE_LIMIT=1
FREE_MESSAGE_WINDOW_HOURS=24

# Live Stripe production values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL_ENTRY_MONTHLY=
STRIPE_PRICE_PERSONAL_ENTRY_ANNUAL=
STRIPE_PRICE_MONTH_PASS=
STRIPE_PRICE_MONTHLY_SUBSCRIPTION=
STRIPE_PRICE_MONTHLY_SUBSCRIPTION_ANNUAL=
STRIPE_PRICE_STUDENT_EXAM_MONTHLY=
BILLING_APP_BASE_URL=https://lovora.example.com
STRIPE_CHECKOUT_SUCCESS_URL=https://lovora.example.com?billing=success
STRIPE_CHECKOUT_CANCEL_URL=https://lovora.example.com?billing=cancel

LEGAL_CHUNK_SIZE_CASELAW=1500
LEGAL_CHUNK_SIZE_STATUTE=1100
